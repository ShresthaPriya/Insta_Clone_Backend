//npx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  fullName      String
  userName      String        @unique
  user_profile  String?
  bio           String?
  gender        String?
  email         String?       @unique
  phoneNumber   String        @unique
  password      String
  phoneVerified Boolean       @default(false)
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  posts         Post[]
  comments      Comments[]
  likes         Like[]
  commentLikes  CommentLike[]

  followers     UserFollows[] @relation("FollowersRelation")
  following     UserFollows[] @relation("FollowingRelation")
   @@map("users")
}

model Otp {
  id            String    @id @default(uuid())
  phoneNumber   String
  otp           String
  expiredAt     DateTime? @default(now())
  nextAttemptAt DateTime
  createdAt     DateTime  @default(now())
  userInfo      Json
  attemptCount  Int       @default(0)
  @@map("otp")
}

model Post {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption       String?
  tags          String?
  location      String?
  urls          String[]
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)

  likes    Like[]
  comments Comments[]

  createdAt DateTime @default(now())

  @@map("posts")
}

model Comments {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentCommentId String?

  replies Comments[] @relation("CommentReplies")
  parent  Comments?  @relation("CommentReplies", fields: [parentCommentId], references: [id])

  text      String
  createdAt DateTime @default(now())

  likes CommentLike[]

  @@map("comments")
}

model Like {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("likes")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  comment   Comments @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model UserFollows {
  follower     User    @relation("FollowingRelation", fields: [followerId], references: [id])
  followerId   String
  following    User    @relation("FollowersRelation", fields: [followingId], references: [id])
  followingId  String
  createdAt    DateTime @default(now())

  @@id([followerId, followingId])
  @@map("user_follows")
}

